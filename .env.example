# Copy to .env and adjust. All variables are optional — the app runs with
# sensible defaults from config.yaml when they are unset.
#
# Consumed by docker-compose.yml and, where noted, by the app directly.

# --- Image generation backend: pollinations | huggingface | comfyui ---------
IMAGEGEN_BACKEND=pollinations

# Hugging Face Inference API token (only for IMAGEGEN_BACKEND=huggingface).
HF_TOKEN=

# --- Prompt strategy: auto | template | ollama ------------------------------
# 'auto' uses Ollama if reachable at OLLAMA_URL, else a deterministic template.
PROMPTING_STRATEGY=auto
OLLAMA_URL=http://ollama:11434

# --- Server / storage (mostly for non-Docker or custom deployments) ---------
# SERVER_HOST=0.0.0.0
# SERVER_PORT=8000
# DATA_DIR=/data
