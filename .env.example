# Copy to .env and adjust. All variables are optional — the app runs with
# sensible defaults from config.yaml when they are unset.
#
# Consumed by docker-compose.yml and, where noted, by the app directly.

# --- Image generation backend: pollinations | huggingface | comfyui ---------
# This is only the preferred backend. If it errors at generation time, the
# app automatically falls back to any other backend that's usable on this
# host (e.g. huggingface, if HF_TOKEN below is set) before giving up.
IMAGEGEN_BACKEND=pollinations

# Hugging Face Inference API token. Set this even when IMAGEGEN_BACKEND is
# pollinations to enable it as an automatic fallback.
HF_TOKEN=

# --- Prompt strategy: auto | template | ollama ------------------------------
# 'auto' uses Ollama if reachable at OLLAMA_URL, else a deterministic template.
PROMPTING_STRATEGY=auto
OLLAMA_URL=http://ollama:11434

# --- Docker host port mappings -----------------------------------------------
# Change these if they collide with another project's containers on this host
# (defaults deliberately avoid the common 8000/3000 range).
BACKEND_PORT=8010
FRONTEND_PORT=8080
OLLAMA_PORT=11434

# --- Server / storage (mostly for non-Docker or custom deployments) ---------
# SERVER_HOST=0.0.0.0
# SERVER_PORT=8000
# DATA_DIR=/data

# --- Security -----------------------------------------------------------------
# Comma-separated list of allowed browser origins for the REST/WS API.
# Defaults to the Vite dev server (localhost:5173). Add your GitHub Pages
# origin (e.g. https://<user>.github.io) when serving the frontend remotely.
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Shared secret required on all /api/* routes (except /api/health) via the
# X-API-Key header, and on /ws/{id} via ?api_key=. Unset = open API (local/dev
# default). Set this before exposing the backend beyond localhost.
# API_KEY=

# Seconds of REST/WS inactivity before an abandoned session (and its camera
# thread) is automatically stopped and freed.
# SESSION_TTL_S=1800

# Max POST requests (session creation, forced generation) per minute per
# client IP. 0 = disabled (local/dev default). Set a small number (e.g. 10)
# when exposing the backend publicly.
# RATE_LIMIT_PER_MINUTE=0
